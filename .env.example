# Takumi Guard のメール認証トークン（tg_anon_ プレフィックス）
# https://shisho.dev/docs/ja/t/guard/features/token-management.md#email-register
TG_AUTH_TOKEN=tg_anon_xxxxxxxx

# Docker ホスト側ポート（3000 が使用中なら pnpm start が空きポートを自動選択）
# TPC_HOST_PORT=3000

# ローカル LLM エージェント（コメント投稿時の変更提案）
# auto = Ollama 疎通確認後に有効（デフォルト）
# TPC_LOCAL_AGENT=auto
# TPC_LOCAL_AGENT=off
# TPC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# TPC_OLLAMA_MODEL=qwen2.5:7b-instruct
# TPC_LOCAL_AGENT_TIMEOUT_MS=120000
# OpenAI 互換 API（LM Studio 等）を明示利用する場合
# TPC_LOCAL_AGENT=openai_compatible
# TPC_OPENAI_COMPATIBLE_URL=http://127.0.0.1:1234/v1
# TPC_OPENAI_COMPATIBLE_MODEL=your-model
