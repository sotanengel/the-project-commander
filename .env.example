# Claude Code CLI 連携（コメント投稿時の AI 変更提案）
# auto = 自動（デフォルト）。Docker 時は host agent、ローカル時は claude 直実行
# TPC_CLI_AGENT=auto
# TPC_CLI_AGENT=off
# ホストエージェント（Docker 用。pnpm start で自動起動、ポート 9477）
# TPC_CLAUDE_HOST=http://host.docker.internal:9477
# TPC_CLAUDE_HOST_PORT=9477
# コンテナ MCP をホスト claude から見せる URL（pnpm start が自動設定）
# TPC_MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
# TPC_CLAUDE_BIN=claude
# TPC_CLAUDE_SKIP_PERMISSIONS=1
# TPC_CLAUDE_TIMEOUT_MS=120000
