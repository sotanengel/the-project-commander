# Takumi Guard のメール認証トークン（tg_anon_ プレフィックス）
# https://shisho.dev/docs/ja/t/guard/features/token-management.md#email-register
TG_AUTH_TOKEN=tg_anon_xxxxxxxx

# Docker ホスト側ポート（3000 が使用中なら pnpm start が空きポートを自動選択）
# TPC_HOST_PORT=3000

# Claude Code CLI 連携（コメント投稿時の AI 変更提案）
# auto = PATH 上の claude を自動検出（デフォルト）。明示的に無効: off
# TPC_CLI_AGENT=auto
# TPC_CLI_AGENT=off
# TPC_CLAUDE_BIN=claude
# MCP ツール実行時の権限確認をスキップ（サーバー非対話実行向け、デフォルト on）
# TPC_CLAUDE_SKIP_PERMISSIONS=1
# TPC_CLAUDE_TIMEOUT_MS=120000
